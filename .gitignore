# --- data -------------------------------------------------------------------
# Nothing under data/ is committed. The synthetic files that live there share
# their filenames with the real Fixed-Site Monitoring Network data on purpose,
# so ignoring the whole directory — rather than each name — is what keeps the
# real data uncommittable if you ever drop it in here. Keep the real data in
# the private repo.
/data/

# The generator that produces data/ is kept local too, so a clone has neither
# the data nor a way to rebuild it. Both live in the private repo.
/make_sample_data.py

# paths that only ever held real data
/nbsmn20/
/formatted_bullock/

# fitted models — data-derived, and pickles are unsafe to distribute.
# regenerate them by running the notebooks.
*.pkl
*.joblib
shap_values.csv

# --- python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/
*.egg-info/

# --- tooling / local state --------------------------------------------------
.claude/
.gstack/
.streamlit/secrets.toml
.DS_Store
.vscode/
.idea/

# --- prophet / cmdstan build artifacts --------------------------------------
stan_model/
